# ============================================================
# AI Business Intelligence Assistant – Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- LLM Provider ---
# Supported values: openai | gemini | anthropic | groq
LLM_PROVIDER=gemini

# --- API Key ---
# Provide the API key for the selected provider (or provider-specific env var:
# OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY).
# OpenAI:    https://platform.openai.com/api-keys
# Gemini:    https://aistudio.google.com/app/apikey
# Anthropic: https://console.anthropic.com/settings/keys
# Groq:      https://console.groq.com/keys
LLM_API_KEY=

# --- Model Name ---
# OpenAI examples:    gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Gemini examples:    gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# Anthropic examples: claude-3-haiku-20240307, claude-3-5-sonnet-20241022
# Groq examples:      llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
LLM_MODEL=gemini-1.5-flash

# --- Optional: Custom API Base URL ---
# Useful for proxies or self-hosted compatible endpoints.
# Leave blank to use the provider's default endpoint.
LLM_API_BASE_URL=

# --- Request Settings ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Database ---
DATABASE_PATH=sales.db
CSV_PATH=sales_data.csv
